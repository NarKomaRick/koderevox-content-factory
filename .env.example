APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://content_factory:content_factory@postgres:5432/content_factory
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=123456789
BACKEND_URL=http://api:8000

# openai_compatible, mock
AI_PROVIDER=mock
AI_BASE_URL=http://host.docker.internal:1234/v1
AI_API_KEY=lm-studio
AI_MODEL=local-model
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2

STT_PROVIDER=faster_whisper
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
MEDIA_ROOT=/data/media
MAX_MEDIA_SIZE_MB=200

LINK_FETCH_TIMEOUT_SECONDS=15
LINK_MAX_SIZE_MB=10
LINK_MAX_REDIRECTS=5
DOCUMENT_MAX_CHARS=100000

VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_CRF=20
VIDEO_PRESET=medium
VIDEO_MIN_DURATION=5
VIDEO_MAX_DURATION=75

PAUSE_REMOVAL_ENABLED=true
PAUSE_MIN_DURATION=0.65
PAUSE_KEEP_PADDING=0.12
PAUSE_NOISE_DB=-35

AUDIO_NORMALIZATION_ENABLED=true
AUDIO_NOISE_REDUCTION_ENABLED=false
HOOK_OVERLAY_ENABLED=true
VIDEO_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

RENDER_TEMP_ROOT=/tmp/content-factory/render
TELEGRAM_PREVIEW_MAX_SIZE_MB=48
CELERY_RENDER_CONCURRENCY=1
