APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://content_factory:content_factory@postgres:5432/content_factory
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY_URL=
TELEGRAM_PUBLISH_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=123456789
INITIAL_OWNER_TELEGRAM_ID=123456789
# Fernet key; generate with the command shown below. Never store the filled key in Git.
APP_MASTER_KEY=
BACKEND_URL=http://api:8000
DEFAULT_TIMEZONE=Europe/Moscow

# openai_compatible, mock
AI_PROVIDER=mock
AI_BASE_URL=http://host.docker.internal:1234/v1
AI_API_KEY=lm-studio
AI_MODEL=local-model
AI_TIMEOUT_SECONDS=120
AI_MAX_TOKENS=1536
AI_MAX_RETRIES=2

TTS_PROVIDER=espeak
TTS_LANGUAGE=ru
TTS_VOICE=
TTS_RATE=125
TTS_VOLUME=

STT_PROVIDER=faster_whisper
STT_MODEL=small
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
MEDIA_ROOT=/data/media
MAX_MEDIA_SIZE_MB=200

LINK_FETCH_TIMEOUT_SECONDS=15
LINK_MAX_SIZE_MB=10
LINK_MAX_REDIRECTS=5
DOCUMENT_MAX_CHARS=100000

VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_CRF=20
VIDEO_PRESET=medium
VIDEO_ENCODER=h264_nvenc
VIDEO_MIN_DURATION=5
VIDEO_MAX_DURATION=75

PAUSE_REMOVAL_ENABLED=true
PAUSE_MIN_DURATION=0.65
PAUSE_KEEP_PADDING=0.12
PAUSE_NOISE_DB=-35

AUDIO_NORMALIZATION_ENABLED=true
AUDIO_NOISE_REDUCTION_ENABLED=false
HOOK_OVERLAY_ENABLED=true
VIDEO_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

RENDER_TEMP_ROOT=/tmp/content-factory/render
CAPABILITY_ARTIFACT_DIR=/data/capability-test-artifacts/latest
TELEGRAM_PREVIEW_MAX_SIZE_MB=48

# Phase 6 LLM Director. Keep disabled until the runtime is explicitly enabled.
DIRECTOR_ENABLED=false
DIRECTOR_MAX_STEPS=24
DIRECTOR_MAX_LLM_CALLS=12
DIRECTOR_MAX_PREVIEW_RENDERS=3
DIRECTOR_MAX_CRITIC_ITERATIONS=3
DIRECTOR_MAX_REVIEW_ITERATIONS=3
DIRECTOR_MAX_CRITIC_CALLS=15
DIRECTOR_MAX_CORRECTION_ACTIONS=12
DIRECTOR_MAX_SEARCH_QUERIES_PER_BEAT=3
DIRECTOR_TARGET_QUALITY=8.0
DIRECTOR_MAX_EXTERNAL_ASSETS=5
DIRECTOR_MAX_EXTERNAL_BYTES=104857600
DIRECTOR_ALLOW_WEB_ASSETS=false
DIRECTOR_CONTEXT_ASSET_LIMIT=100
CELERY_RENDER_CONCURRENCY=1

# Phase 8 autonomous Producer. Offline/fake research is the safe default.
PRODUCER_ENABLED=false
PRODUCER_MAX_STEPS=24
PRODUCER_MAX_LLM_CALLS=12
PRODUCER_MAX_SEARCH_QUERIES=4
PRODUCER_MAX_SOURCES=8
PRODUCER_MAX_FETCHES=8
PRODUCER_MAX_SCRIPT_ITERATIONS=2
PRODUCER_MAX_ANGLE_CANDIDATES=3
PRODUCER_MAX_RESEARCH_BYTES=2097152
PRODUCER_RESEARCH_STALE_DAYS=30
PRODUCER_STRICT_FACTUALITY=true
PRODUCER_RESEARCH_EXTRACTOR_VERSION=producer-html-v1

# Phase 9 content operations. Keep autonomous starts and auto-publish disabled by default.
OPERATIONS_ENABLED=false
OPERATIONS_DRY_RUN=false
OPERATIONS_PLANNING_HORIZON_DAYS=14
OPERATIONS_MAX_PLANNED_ITEMS=50
OPERATIONS_MAX_ACTIVE_ITEMS=5
OPERATIONS_MAX_PRODUCER_CONCURRENCY=1
OPERATIONS_MAX_DIRECTOR_CONCURRENCY=1
OPERATIONS_MAX_RENDER_CONCURRENCY=1
OPERATIONS_MAX_PENDING_RENDER=5
OPERATIONS_MAX_PENDING_APPROVAL=20
OPERATIONS_TICK_INTERVAL_SECONDS=180
OPERATIONS_PRODUCER_STALE_SECONDS=3600
OPERATIONS_DIRECTOR_STALE_SECONDS=3600
OPERATIONS_RENDER_STALE_SECONDS=3600
OPERATIONS_MAX_PRODUCER_RETRIES=2
OPERATIONS_MAX_DIRECTOR_RETRIES=2
OPERATIONS_MAX_RENDER_RETRIES=2
OPERATIONS_MAX_PUBLISH_RETRIES=2
OPERATIONS_RETRY_DELAYS_SECONDS=60,300,900
OPERATIONS_MAX_LLM_CALLS_PER_DAY=100
OPERATIONS_MAX_RESEARCH_SEARCHES_PER_DAY=100
OPERATIONS_MAX_RETRIES_PER_DAY=20
OPERATIONS_AUTO_PUBLISH=false

# Durable live progress. ETA is shown only when production timing history exists.
PROGRESS_UPDATES_ENABLED=true
PROGRESS_UPDATE_INTERVAL_SECONDS=20
PROGRESS_MIN_PERCENT_DELTA=0.03
PROGRESS_DETAIL_LEVEL=normal
PROGRESS_SHOW_ETA=true

# Phase 4.5 voiceover-driven assembly guidelines and cheap preview profile.
ASSEMBLY_TARGET_VISUAL_CHANGE_MIN_SECONDS=3
ASSEMBLY_TARGET_VISUAL_CHANGE_MAX_SECONDS=6
ASSEMBLY_MAX_SCREENSHOT_SECONDS=8
PREVIEW_WIDTH=720
PREVIEW_HEIGHT=1280
PREVIEW_CRF=27
PREVIEW_PRESET=veryfast
SETUP_SENSITIVE_RATE_LIMIT_SECONDS=10

# Phase 4 visual assets. External vision is opt-in twice: here and per Project.
VISION_ENABLED=false
VISION_PROVIDER=openai_compatible
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
OCR_ENABLED=true
OCR_LANGUAGE=rus+eng
MAX_IMAGE_PIXELS=40000000
MAX_ASSET_SIZE_MB=200
MAX_ASSET_DURATION=600

VISUAL_MIN_INSERT_DURATION=1.5
VISUAL_MAX_INSERT_DURATION=8
VISUAL_MIN_GAP_SECONDS=2
VISUAL_MAX_INSERTS_PER_MINUTE=10
VISUAL_SAFE_MARGIN_TOP=140
VISUAL_SAFE_MARGIN_BOTTOM=360
THUMBNAIL_WIDTH=1280
THUMBNAIL_HEIGHT=720

# Phase 5 publishing. Generate a Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
PUBLISH_SCHEDULER_INTERVAL_SECONDS=30
PUBLISH_MAX_ATTEMPTS=5
PUBLISH_RETRY_DELAYS_SECONDS=60,300,900,3600
CELERY_PUBLISH_CONCURRENCY=2

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_WEBHOOK_TOLERANCE_SECONDS=300
